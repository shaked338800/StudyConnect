# Copy this file to ".env" (same folder) and fill in the values.
# The real .env file is ignored by Git (requirement 7: no secrets in Git).

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/studyconnect

# Secret used to sign the session cookie. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# AI quiz: Google Gemini API key from https://aistudio.google.com/apikey
# Keep it ONLY here (server/.env). If it is empty, the AI quiz shows a clear
# "not configured" message and the rest of the app works normally.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
